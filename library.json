{
  "name": "T-Glass-V3",
  "version": "1.0.0",
  "description": "Library for LilyGo T-Glass V3",
  "keywords": "lilygo,amoled,glass,esp32",
  "authors": [
    {
      "name": "Xinyuan-LilyGO",
      "url": "https://github.com/Xinyuan-LilyGO"
    },
    {
      "name": "LewisHe",
      "url": "https://github.com/lewisxhe",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Xinyuan-LilyGO/T-Glass-V3.git"
  },
  "homepage": "https://github.com/Xinyuan-LilyGO/T-Glass-V3",
  "export": {
